{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nyan Clock",
  "identifier": "com.github.nyan-clock",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nyan Clock",
        "width": 210,
        "height": 24,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true,
        "backgroundColor": "#003366"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico"]
  }
}
